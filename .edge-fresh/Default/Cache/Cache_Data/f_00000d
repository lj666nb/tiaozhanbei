function activityColor(type) { return activityColorMap[type] || '#909399' }

// ===== 问候语 =====
const todayDate = computed(() => {
  const now = new Date()
  return `${now.getFullYear()}年${now.getMonth() + 1}月${now.getDate()}日 ${['日','一','二','三','四','五','六'][now.getDay()]}`
