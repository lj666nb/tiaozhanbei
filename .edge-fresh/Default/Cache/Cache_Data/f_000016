        [task.lab_id]: {
          completed_stages: completedStages,
          total_stages: workspace.course?.stages?.length || 6,
          stage_ids: (workspace.course?.stages || []).map(s => s.id),
        },
      }
    }
    learnDialogTitle.value = resource.matched_tag || task.topic
    tutorialMeta.value = {
