async function doAIGenerate() {
  aiGenLoading.value = true
  try {
    const result = await generateAITutorial({
      knowledge_tag: aiGenForm.knowledge_tag,
      topic: aiGenForm.topic,
      goal: aiGenForm.goal
    })
    showAIDialog.value = false
    ElMessage.success('AI 教程已生成！')
