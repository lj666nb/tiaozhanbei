      bindCodeBlockActions(materialRef.value)
      rebuildArticleOutline()
    }
  } catch (e) {
    ElMessage.error('AI 生成失败: ' + (e.response?.data?.message || e.message))
  } finally {
    aiGenLoading.value = false
  }
}

